# ==================================
# 开发环境配置文件模版:复制此文件为 .env.dev 并修改配置
# ==================================

ENVIRONMENT = "dev"

# 服务器配置
SERVER_HOST = "localhost"     # 允许访问的IP地址
SERVER_PORT = 8001          # 服务端口

# 文档配置
DEBUG = True                        # 调试模式
TITLE = "🎉 FastCore 🎉 -dev"    # 文档标题
VERSION = "0.1.0"                   # 版本号
SUMMARY = "接口汇总"                 # 文档概述
DOCS_URL = "/docs"                  # Swagger UI路径
REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api/v1"               # API路由前缀
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置
DATABASE_TYPE = "mysql"  # 正式支持 mysql 或 postgresql；SQLite 仅用于自动化测试
DATABASE_AUTO_CREATE_TABLES = True  # 开发环境可自动创建缺失表

# JWT 密钥（仅开发环境示例，生产必须替换为随机值）
SECRET_KEY = "dev-only-change-this-secret-before-sharing"

# 数据库配置
DATABASE_HOST = "localhost"
# 不设置时按数据库类型使用默认端口：MySQL 3306、PostgreSQL 5432
DATABASE_USER = "root"
DATABASE_PASSWORD = "your_database_password"
DATABASE_NAME = "fastcore"

# Redis配置
REDIS_ENABLE = True 
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = "your_redis_password"
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "DEBUG"   # 日志级别

# 核心 AI 与向量检索配置
OPENAI_BASE_URL = "https://api.minimax.chat"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-v4-flash"

EMBEDDING_PROVIDER = "local"
LOCAL_EMBEDDING_MODEL = "BAAI/bge-small-zh-v1.5"
LOCAL_EMBEDDING_CACHE_DIR = "./data/fastembed"
OPENAI_EMBEDDING_MODEL = ""
CHROMA_PERSIST_DIR = "./data/chroma"
CHROMA_COLLECTION_NAME = "knowledge_base"

# 混合检索配置
RETRIEVAL_MODE = "hybrid"  # vector(纯向量) | bm25(纯关键词) | hybrid(混合，推荐)
HYBRID_ALPHA = 0.5         # 混合检索中向量权重(0-1)，0.5表示向量和BM25各占50%
BM25_INDEX_DIR = "./data/bm25_index"
BM25_TOKENIZER = "jieba"   # char(单字分词) | jieba(词组分词，推荐)
RETRIEVAL_TOP_K = 5
RETRIEVAL_CANDIDATE_MULTIPLIER = 4
RETRIEVAL_AUTO_ADJUST_ALPHA = True  # 是否根据查询类型自动调整alpha

# IP 归属地查询（登录时对外请求第三方 API，生产建议关闭）
IP_LOCATION_ENABLE=False

# 第三方登录（可选）。留空的渠道会提示未配置；密钥只放后端环境文件。
# 回跳地址必须与浏览器打开的登录页一致。白名单是 JSON 数组，只写 scheme://host[:port]。
# 各平台登记的授权回调：{对外访问的后端地址}{ROOT_PATH}/system/auth/oauth/{github|gitee|wechat|qq}/callback
# 反向代理要把这条外部路径转到应用路由 /system/auth/oauth/...（去掉 ROOT_PATH 前缀）。
OAUTH_FRONTEND_FALLBACK = "http://127.0.0.1:5180/login"
OAUTH_ALLOWED_REDIRECT_ORIGINS = ["http://127.0.0.1:5180", "http://localhost:5180"]
OAUTH_GITHUB_CLIENT_ID = ""
OAUTH_GITHUB_CLIENT_SECRET = ""
OAUTH_GITEE_CLIENT_ID = ""
OAUTH_GITEE_CLIENT_SECRET = ""
OAUTH_WECHAT_OPEN_APP_ID = ""
OAUTH_WECHAT_OPEN_APP_SECRET = ""
OAUTH_QQ_APP_ID = ""
OAUTH_QQ_APP_SECRET = ""
